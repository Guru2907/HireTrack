MONGO_URI=your_mongodb_atlas_connection_string
JWT_SECRET=replace_with_a_long_random_string
PORT=5000
GEMINI_API_KEY=your_gemini_api_key
GROQ_API_KEY=your_groq_api_key_here
CLIENT_URL=http://localhost:5173

# Resume matcher providers. Gemini is the primary; Groq is an automatic backup used when Gemini is
# overloaded, rate limited, out of quota, misconfigured or returns unusable output.
# Leave GROQ_API_KEY empty to disable the backup. The model names are optional (defaults shown).
# GEMINI_MODEL=gemini-3.8-flash
# GROQ_MODEL=openai/gpt-oss-20b

# Number of reverse proxies in front of this app. Leave unset when running locally.
# Behind proxies the login rate limiter sees the nearest proxy's IP unless this is set, so all users would
# share one limit. The correct value is the exact number of proxies between the internet and this app, and it
# must be MEASURED on the real deployment, not assumed. Render's guides say traffic passes through Cloudflare
# and then Render's load balancers (more than one layer) but give no hop count. To measure: log
# req.socket.remoteAddress, the X-Forwarded-For header, req.ip and req.ips for requests from two different
# networks, plus one request with a forged X-Forwarded-For. The right count makes req.ip equal each real
# client IP and never equal the forged value.
# Never use "true". A count larger than the real number of proxies lets clients spoof their IP and bypass
# the rate limiter; a smaller count makes many users share one rate-limit bucket.
# TRUST_PROXY=<measured hop count>


# Optional rate-limit overrides (defaults: 10 failed logins / 15 min and 10 signups / hour, per IP)
# AUTH_LOGIN_MAX=10
# AUTH_SIGNUP_MAX=10
# Failed password changes per signed-in user per 15 min (default 5)
# AUTH_PASSWORD_MAX=5
